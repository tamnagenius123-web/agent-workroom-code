{
  "name": "agent-workroom",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "bin": {
    "workroom": "dist/workroom.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-select.mjs",
    "test:browser": "tsx scripts/browser-test.ts && tsx scripts/browser-g2-test.ts && tsx scripts/browser-g3-test.ts",
    "dev": "tsx scripts/dev.ts",
    "check": "npm run typecheck && npm run lint && node scripts/test-select.mjs",
    "test:affected": "node scripts/test-select.mjs",
    "test:smoke": "node scripts/test-select.mjs --smoke",
    "test:all": "node scripts/test-select.mjs --all",
    "test:select": "node scripts/test-select.mjs --list",
    "call": "tsx scripts/or-call.ts",
    "test:or-harness": "tsx --test tests/or-harness-*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "miniflare": "4.20260730.0",
    "playwright-core": "1.58.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  }
}
